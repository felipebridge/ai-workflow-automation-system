# Application
APP_NAME="AI Workflow Automation Agent"
DEBUG=false

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# AI Configuration
# Leave empty to use built-in rule-based engine (no API key needed)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# AI_MODE options: auto (use AI if key present), ai (force AI), mock (force rules)
AI_MODE=auto

# Decision Thresholds (0-100)
CONFIDENCE_AUTO_THRESHOLD=78.0
CONFIDENCE_REVIEW_THRESHOLD=50.0
HIGH_VALUE_THRESHOLD=10000.0

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
